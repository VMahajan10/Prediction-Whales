# Copy to android/keystore.properties and fill in real values.
# Generate keystore:
#   keytool -genkey -v -keystore android/keystores/marketpulse-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias marketpulse

storeFile=../keystores/marketpulse-release.jks
storePassword=CHANGE_ME
keyAlias=marketpulse
keyPassword=CHANGE_ME
