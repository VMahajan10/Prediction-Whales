DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
CRON_SECRET=your_cron_secret_for_ev_pipeline
OPENAI_API_KEY=your_openai_api_key
# Optional: gpt-4o (default), gpt-4o-mini, etc.
PROBABILITY_LLM_MODEL=gpt-4o
KALSHI_KEY_ID=your_kalshi_api_key_id
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# The Odds API — sportsbook consensus for cross-market EV (optional)
ODDS_API_KEY=your_the_odds_api_key
# Optional override if sport key differs from default soccer_fifa_world_cup
# ODDS_API_SPORT_KEY=soccer_fifa_world_cup

# App Store / Play Store review bypass (Guideline 2.1)
# Client-visible NEXT_PUBLIC_* vars — toggle on Vercel only during active
# Apple App Store / Google Play review cycles, then disable after approval.
NEXT_PUBLIC_APP_REVIEW_MODE=false
# Optional query fallback when review mode is off:
# https://your-app.vercel.app/?review=<token>
NEXT_PUBLIC_APP_REVIEW_BYPASS_TOKEN=
