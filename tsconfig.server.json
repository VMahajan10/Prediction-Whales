{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@kalshi/sdk": ["./lib/kalshi-sdk"]
    },
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": false,
    "jsx": "react",
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "scripts/run-shadow-cron.ts",
    "scripts/run-cron-publisher.ts",
    "scripts/preload-env.ts",
    "scripts/loadEnv.ts",
    "scripts/workerBootstrap.ts",
    "types/server-fetch.d.ts",
    "lib/x-agent/**/*.ts",
    "lib/x-agent/**/*.tsx",
    "lib/evPipeline/**/*.ts",
    "lib/arbitrageFinder/**/*.ts",
    "lib/crossmarket/**/*.ts",
    "lib/ai/**/*.ts",
    "lib/finance/**/*.ts",
    "lib/kalshi-sdk/**/*.ts",
    "lib/polymarket.ts",
    "lib/polymarketLiveSocket.ts",
    "lib/prisma.ts",
    "lib/whaleTrades.ts",
    "lib/resolveWhaleWallet.ts",
    "lib/fetchWithTimeout.ts",
    "lib/appBaseUrl.ts",
    "lib/templates/**/*.ts",
    "lib/email/**/*.ts",
    "lib/averageEvDisplay.ts",
    "lib/clvPriceHistory.ts",
    "lib/kalshi.ts",
    "lib/kalshiDetail.ts",
    "lib/kalshiTitleResolver.ts",
    "lib/marketCategory.ts",
    "lib/tradeDetail.ts",
    "lib/whaleSignals.ts",
    "lib/whaleTrackStore.ts",
    "lib/whaleTweetNotifier.ts"
  ],
  "exclude": [
    "node_modules",
    "app/**",
    "components/**",
    "tests/**",
    "**/*.test.ts",
    "lib/**/**.test.ts",
    "lib/x-agent/x-agent.test.ts",
    "lib/use*.ts",
    "lib/**/*Client.ts",
    "lib/bookmarkedTraders.ts",
    "lib/copyTracking.ts",
    "lib/demoAuthGate.ts",
    "lib/explorer.ts",
    "lib/liveFeedPlatform.ts",
    "lib/portfolio.ts",
    "lib/tradeNavigationStore.ts",
    "lib/traderAlerts.ts",
    "lib/whaleCache.ts",
    "lib/PolymarketSocketProvider.tsx",
    "lib/usePolymarketSocket.ts",
    "lib/crossMarketEv.ts",
    "lib/crossMarketEvIndexClient.ts",
    "lib/marketMovers.ts",
    "lib/marketPrices.ts",
    "lib/pipelineEvClient.ts",
    "lib/kalshiTrades.ts"
  ]
}
