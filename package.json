{
  "name": "marketpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "pipeline:trigger": "wait-on http://localhost:3000 && sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; curl -fsS -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3000/api/cron/ev-pipeline'",
    "dev:all": "concurrently \"npm run dev\" \"npm run pipeline:trigger\"",
    "build": "npx prisma generate && next build && npm run build:worker",
    "postinstall": "prisma generate",
    "build:worker": "prisma generate && tsc -p tsconfig.server.json",
    "start": "next start",
    "lint": "next lint",
    "cap:sync": "npx cap sync",
    "cap:sync:local": "CAPACITOR_SERVER_MODE=local npx cap sync",
    "cap:sync:prod": "CAPACITOR_SERVER_MODE=production npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "build:mobile": "next build && cap sync",
    "build:android": "cd android && ./gradlew bundleRelease",
    "assets:generate": "npx @capacitor/assets generate",
    "assets:generate:ios": "npx @capacitor/assets generate --ios",
    "assets:generate:android": "npx @capacitor/assets generate --android",
    "assets:sync": "npm run assets:generate && npm run cap:sync",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:repair": "npx tsx --tsconfig tsconfig.json scripts/repairFeedSchema.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "test:phase0-phase1": "npx tsx --tsconfig tsconfig.json lib/evPipeline/phase0Phase1.test.ts",
    "test:phase4": "npx tsx --tsconfig tsconfig.json lib/evPipeline/phase4.test.ts",
    "test:phase5": "npx tsx --tsconfig tsconfig.json lib/evPipeline/phase5.test.ts",
    "test:rag-live": "npx tsx --tsconfig tsconfig.json scripts/test-rag-live.ts",
    "backfill:ptrue": "npx tsx --tsconfig tsconfig.json scripts/backfill-ptrue.ts",
    "report:pipeline-coverage": "npx tsx --tsconfig tsconfig.json scripts/pipeline-coverage-report.ts",
    "flush:ev-cache": "npx tsx --tsconfig tsconfig.json scripts/flush-ev-cache.ts",
    "test:live-ptrue": "npx tsx --tsconfig tsconfig.json scripts/test-live-ptrue-workflow.ts",
    "test:arb-phase01": "npx tsx --tsconfig tsconfig.json lib/arbitrageFinder/phase01.test.ts",
    "test:arb-phase02": "npx tsx --tsconfig tsconfig.json lib/arbitrageFinder/phase02.test.ts",
    "test:arb-phase04": "npx tsx --tsconfig tsconfig.json lib/arbitrageFinder/phase04.test.ts",
    "test:arb-phase05": "npx tsx --tsconfig tsconfig.json lib/arbitrageFinder/phase05.test.ts",
    "test:arb-phase06": "npx tsx --tsconfig tsconfig.json lib/arbitrageFinder/phase06.test.ts",
    "test:arb-phase07": "npx tsx --tsconfig tsconfig.json lib/arbitrageFinder/phase07.test.ts",
    "report:arb-coverage": "npx tsx --tsconfig tsconfig.json scripts/arb-coverage-report.ts",
    "test": "vitest run",
    "test:x-agent": "vitest run tests/x-agent",
    "test:email": "npx tsx --tsconfig tsconfig.json scripts/testEmail.ts",
    "cron:publisher": "npx tsx --tsconfig tsconfig.json scripts/run-cron-publisher.ts",
    "cron:publisher:once": "npx tsx --tsconfig tsconfig.json scripts/run-cron-publisher.ts --once",
    "test:pipeline": "ts-node --transpile-only --project tsconfig.scripts.json -r tsconfig-paths/register scripts/test-full-pipeline.ts",
    "test:watch": "vitest",
    "shadow:watch": "ts-node --transpile-only --project tsconfig.scripts.json scripts/run-shadow-cron.ts",
    "start:worker": "TS_NODE_PROJECT=tsconfig.server.paths.json node --max-old-space-size=4096 -r ./dist/scripts/preload-env.js -r tsconfig-paths/register dist/scripts/run-shadow-cron.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.77",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@neondatabase/serverless": "^1.0.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/og": "^0.11.1",
    "ai": "^6.0.214",
    "drizzle-orm": "^0.44.0",
    "kalshi-typescript": "^3.20.0",
    "next": "14.2.35",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "twitter-api-v2": "^1.29.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^7.9.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "ts-node": {
    "project": "tsconfig.scripts.json",
    "transpileOnly": true,
    "require": [
      "tsconfig-paths/register"
    ]
  }
}
